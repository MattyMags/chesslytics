# ── Client (Vite — safe to expose) ──────────────────────────
VITE_PLAYER1_LABEL=Your Name
VITE_PLAYER1_USERNAME=your-lichess-username

VITE_PLAYER2_LABEL=Friend Name
VITE_PLAYER2_USERNAME=friend-lichess-username

# ── Server (Vercel API routes — keep secret) ────────────────
PLAYER1_USERNAME=your-lichess-username
PLAYER1_TOKEN=lip_your_token_here

PLAYER2_USERNAME=friend-lichess-username
PLAYER2_TOKEN=lip_friend_token_here

# ── Supabase ────────────────────────────────────────────────
# Project URL only — do NOT include /rest/v1/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
